# QuranPilot production deploy — defaults for quranpilot.com
# Auto-created by scripts/deploy-production.sh if missing.
# Or: cp deploy/production.env.example deploy/production.env

# Public domain
DOMAIN=quranpilot.com
WWW_DOMAIN=www.quranpilot.com

# Derived public URLs (auto-written by deploy / sync-public-env / clean-reinstall)
FRONTEND_URL=https://quranpilot.com
CORS_ORIGINS=https://quranpilot.com,https://www.quranpilot.com
NEXT_PUBLIC_API_URL=https://quranpilot.com/api/v1
AUDIO_PUBLIC_BASE_URL=https://quranpilot.com/api/v1/audio/files

# Let's Encrypt account email (required for SSL)
CERTBOT_EMAIL=admin@quranpilot.com

# Absolute path to this repo on the server
APP_DIR=/var/www/al-tarteel-web

# Nginx site name → /etc/nginx/sites-available/quranpilot
SITE_NAME=quranpilot

# Localhost ports (must match docker-compose.prod.yml)
WEB_PORT=3010
API_PORT=4010

# Skip Quran content download on API boot after first deploy (1 = skip)
SKIP_QURAN_DOWNLOAD=0

# Free Ask AI prompts per visitor IP (production default 3; local leave unset/0)
AI_PROMPT_LIMIT=3

# Strong secret for JWT (script can auto-generate)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_EXPIRES_IN=15m

# Postgres password used by docker-compose.prod.yml
POSTGRES_PASSWORD=quran_secret

# Recreate nginx vhost even if it exists (0|1)
FORCE_VHOST=0

# Skip certbot (0|1)
SKIP_SSL=0

# --- SEO / search-console verification (optional; build-time for Next.js) ---
# Google Search Console HTML-tag content value only (not the full <meta> element)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster HTML meta content value only
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
