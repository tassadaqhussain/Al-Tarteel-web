# Optional: append after Certbot has issued certificates.
# Canonical host: https://quranpilot.com (apex)
#
# Replace DOMAIN / cert paths if needed, then:
#   sudo nginx -t && sudo systemctl reload nginx

# HTTP → HTTPS apex
server {
    listen 80;
    listen [::]:80;
    server_name www.quranpilot.com quranpilot.com;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        try_files $uri =404;
    }
    location / {
        return 301 https://quranpilot.com$request_uri;
    }
}

# HTTPS www → HTTPS apex
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.quranpilot.com;

    ssl_certificate     /etc/letsencrypt/live/quranpilot.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/quranpilot.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://quranpilot.com$request_uri;
}
