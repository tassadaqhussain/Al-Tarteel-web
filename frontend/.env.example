NEXT_PUBLIC_API_URL=http://localhost:4010/api/v1
NEXT_PUBLIC_SITE_URL=https://quranpilot.com
# Production (same-origin via Nginx): NEXT_PUBLIC_API_URL=https://quranpilot.com/api/v1

# Preferred: set GA / Search Console / Bing IDs in Admin → Site (stored in DB, no rebuild).
# Env vars below are fallbacks only until Admin → Site is saved.

# Search engine ownership verification (meta tags). Paste tokens from consoles — do not invent values.
# Google Search Console → Settings / Ownership verification → HTML tag → content="...."
# GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → HTML meta tag → content="...."
# BING_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Privacy-friendly analytics (disabled when NEXT_PUBLIC_ANALYTICS_PROVIDER is unset)
# Provider: ga4 | plausible | umami
# NEXT_PUBLIC_ANALYTICS_PROVIDER=
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_ID=
# Plausible: https://plausible.io — set domain exactly as registered (e.g. quranpilot.com)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=quranpilot.com
# Self-hosted Plausible script URL (optional; default is https://plausible.io/js/script.js)
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js
# Umami website ID and optional self-hosted script URL
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# Sitemap stable build-time lastmod (ISO timestamp, optional)
# SITEMAP_LASTMOD=2026-11-01T00:00:00.000Z

# Optional IndexNow key for Bing/Yandex instant URL submission (served at /<INDEXNOW_KEY>.txt)
# INDEXNOW_KEY=
