NEXT_PUBLIC_API_URL=http://localhost:4010/api/v1
NEXT_PUBLIC_SITE_URL=https://quranpilot.com
# Production (same-origin via Nginx): NEXT_PUBLIC_API_URL=https://quranpilot.com/api/v1

# Search engine ownership verification (meta tags). Paste tokens from consoles — do not invent values.
# Google Search Console → Settings / Ownership verification → HTML tag → content="...."
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → HTML meta tag → content="...."
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Privacy-friendly analytics (optional — enable one or both; rebuild web image after setting)
# Plausible: https://plausible.io — set domain exactly as registered (e.g. quranpilot.com)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=quranpilot.com
# Self-hosted Plausible script URL (optional; default is https://plausible.io/js/script.js)
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
