// Al-Tarteel Quran API — Production schema
// PostgreSQL + Prisma ORM
// Indexing for: surah/ayah lookup, page/juz/hizb/ruku, search, user data

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ——— Core Quran ———

model Surah {
  id            Int      @id @default(autoincrement())
  number        Int      @unique // 1–114
  nameArabic    String   @map("name_arabic")
  nameSimple    String   @map("name_simple")
  nameComplex   String?  @map("name_complex")
  revelationPlace String @map("revelation_place") // meccan / medinan
  revelationOrder Int?   @map("revelation_order")
  numberOfAyahs Int      @map("number_of_ayahs")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  ayahs         Ayah[]
  usersLastRead User[]  @relation("UserLastRead")
  @@index([number])
  @@index([revelationPlace])
  @@map("surahs")
}

model Ayah {
  id          Int    @id @default(autoincrement())
  surahId     Int    @map("surah_id")
  number      Int    // ayah number in surah (1-based)
  numberInQuran Int? @map("number_in_quran") // global 1–6236
  juz         Int?
  hizb        Int?
  manzil      Int?
  ruku        Int?
  page        Int?   // Madani page 1–604
  textUthmani String @map("text_uthmani") @db.Text
  textTajweed String? @map("text_tajweed") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  surah       Surah   @relation(fields: [surahId], references: [id], onDelete: Cascade)
  words       Word[]
  translations AyahTranslation[]
  tafsirs     Tafsir[]
  audioFiles  AudioFile[]
  bookmarks   Bookmark[]
  readingHistory ReadingHistory[]

  @@unique([surahId, number])
  @@index([surahId])
  @@index([page])
  @@index([juz])
  @@index([hizb])
  @@index([ruku])
  @@index([numberInQuran])
  @@map("ayahs")
}

model Word {
  id          Int    @id @default(autoincrement())
  ayahId      Int    @map("ayah_id")
  position    Int    // 1-based in ayah
  textArabic  String @map("text_arabic") @db.VarChar(50)
  textUthmani String @map("text_uthmani") @db.VarChar(50)
  transliteration String? @db.VarChar(100)
  audioUrl    String? @map("audio_url") @db.VarChar(500)
  rootArabic  String? @map("root_arabic") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ayah        Ayah   @relation(fields: [ayahId], references: [id], onDelete: Cascade)
  translations WordTranslation[]

  @@unique([ayahId, position])
  @@index([ayahId])
  @@map("words")
}

// ——— Translations ———

model Translator {
  id          Int    @id @default(autoincrement())
  name        String @db.VarChar(255)
  languageCode String @map("language_code") @db.VarChar(10) // en, ur, ps, etc.
  slug        String @unique @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ayahTranslations AyahTranslation[]

  @@index([languageCode])
  @@index([slug])
  @@map("translators")
}

model AyahTranslation {
  id           Int    @id @default(autoincrement())
  ayahId       Int    @map("ayah_id")
  translatorId Int    @map("translator_id")
  text         String @map("text") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ayah         Ayah       @relation(fields: [ayahId], references: [id], onDelete: Cascade)
  translator   Translator @relation(fields: [translatorId], references: [id], onDelete: Cascade)

  @@unique([ayahId, translatorId])
  @@index([ayahId])
  @@index([translatorId])
  @@map("ayah_translations")
}

model WordTranslation {
  id          Int    @id @default(autoincrement())
  wordId      Int    @map("word_id")
  languageCode String @map("language_code") @db.VarChar(10)
  text        String @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  word        Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([wordId, languageCode])
  @@index([wordId])
  @@index([languageCode])
  @@map("word_translations")
}

// ——— Tafsir ———

model TafsirSource {
  id          Int    @id @default(autoincrement())
  name        String @db.VarChar(255)
  languageCode String @map("language_code") @db.VarChar(10)
  slug        String @unique @db.VarChar(100)
  author      String? @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tafsirs     Tafsir[]

  @@index([languageCode])
  @@map("tafsir_sources")
}

model Tafsir {
  id        Int    @id @default(autoincrement())
  ayahId    Int    @map("ayah_id")
  sourceId  Int    @map("source_id")
  text      String @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ayah      Ayah         @relation(fields: [ayahId], references: [id], onDelete: Cascade)
  source    TafsirSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([ayahId, sourceId])
  @@index([ayahId])
  @@index([sourceId])
  @@map("tafsirs")
}

// ——— Audio ———

model Reciter {
  id          Int    @id @default(autoincrement())
  name        String @db.VarChar(255)
  nameArabic  String? @map("name_arabic") @db.VarChar(255)
  slug        String @unique @db.VarChar(100)
  style       String? @db.VarChar(50) // murattal, mujawwad, etc.
  baseUrl     String? @map("base_url") @db.VarChar(500) // CDN base for verse files
  isDefault   Boolean @default(false) @map("is_default")
  sortOrder   Int     @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  audioFiles  AudioFile[]

  @@index([slug])
  @@index([isDefault])
  @@map("reciters")
}

model AudioFile {
  id        Int    @id @default(autoincrement())
  ayahId    Int    @map("ayah_id")
  reciterId Int    @map("reciter_id")
  url       String @db.VarChar(1000)
  duration  Int?   // seconds
  format    String @default("mp3") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ayah      Ayah    @relation(fields: [ayahId], references: [id], onDelete: Cascade)
  reciter   Reciter @relation(fields: [reciterId], references: [id], onDelete: Cascade)

  @@unique([ayahId, reciterId])
  @@index([ayahId])
  @@index([reciterId])
  @@map("audio_files")
}

// ——— Users & Preferences ———

model User {
  id        Int      @id @default(autoincrement())
  email     String?  @unique @db.VarChar(255)
  passwordHash String? @map("password_hash") @db.VarChar(255)
  name      String?  @db.VarChar(255)
  theme     String   @default("light") @db.VarChar(20) // light, dark, system
  lastReadSurahId Int? @map("last_read_surah_id")
  lastReadAyahNumber Int? @map("last_read_ayah_number")
  lastReadPage Int?  @map("last_read_page")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bookmarks       Bookmark[]
  readingHistory  ReadingHistory[]
  refreshTokens   RefreshToken[]
  passwordResets  PasswordResetToken[]
  dailyGoals      UserDailyGoal[]
  dailyProgress   DailyProgress[]
  motivationPref  UserMotivationPreference?
  hifzAttempts    HifzAttempt[]
  hifzDailyStats  HifzDailyStat[]
  lastReadSurah   Surah? @relation("UserLastRead", fields: [lastReadSurahId], references: [id])

  @@map("users")
}

/// Single hifz recite attempt (speech or typed) for one ayah.
model HifzAttempt {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  surahNumber  Int      @map("surah_number")
  ayahNumber   Int      @map("ayah_number")
  ayahId       Int?     @map("ayah_id")
  /// speech | type
  mode         String   @db.VarChar(20)
  transcript   String   @db.Text
  accuracy     Float
  isCorrect    Boolean  @map("is_correct")
  /// YYYY-MM-DD in user timezone (client-provided)
  practiceDate String   @map("practice_date") @db.VarChar(10)
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, practiceDate])
  @@index([userId, surahNumber, ayahNumber])
  @@map("hifz_attempts")
}

/// Aggregated day-by-day hifz accuracy for charts.
model HifzDailyStat {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  date           String   @db.VarChar(10)
  attempts       Int      @default(0)
  correct        Int      @default(0)
  accuracySum    Float    @default(0) @map("accuracy_sum")
  avgAccuracy    Float    @default(0) @map("avg_accuracy")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("hifz_daily_stats")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")
  userAgent String?  @map("user_agent") @db.VarChar(500)
  ip        String?  @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Allow unauthenticated users to have local-only state; for persisted we use userId
model Bookmark {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id") // null = anonymous/local
  ayahId    Int      @map("ayah_id")
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ayah      Ayah    @relation(fields: [ayahId], references: [id], onDelete: Cascade)

  @@unique([userId, ayahId])
  @@index([userId])
  @@index([ayahId])
  @@map("bookmarks")
}

model ReadingHistory {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  ayahId    Int      @map("ayah_id")
  readAt    DateTime @default(now()) @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ayah      Ayah   @relation(fields: [ayahId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readAt(sort: Desc)])
  @@index([ayahId])
  @@map("reading_history")
}

/// Optional daily learning goal for an authenticated user (non-forced).
model UserDailyGoal {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  /// read_ayahs | read_page | read_minutes | tajweed_rule | listen
  goalType  String   @map("goal_type") @db.VarChar(40)
  goalValue Int      @default(5) @map("goal_value")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("user_daily_goals")
}

/// Per-calendar-day progress (date is YYYY-MM-DD in the user's timezone).
model DailyProgress {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  date             String   @db.VarChar(10)
  ayahsRead        Int      @default(0) @map("ayahs_read")
  minutesRead      Int      @default(0) @map("minutes_read")
  tajweedPracticed Boolean  @default(false) @map("tajweed_practiced")
  goalCompleted    Boolean  @default(false) @map("goal_completed")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_progress")
}

/// Opt-in reminder preferences (never enabled by default).
model UserMotivationPreference {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique @map("user_id")
  reminderEnabled Boolean  @default(false) @map("reminder_enabled")
  /// morning | afternoon | evening | custom
  reminderSlot    String?  @map("reminder_slot") @db.VarChar(20)
  reminderTime    String?  @map("reminder_time") @db.VarChar(5) // HH:mm
  timezone        String   @default("UTC") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_motivation_preferences")
}

/// Reviewable motivational messages (admin-ready). Only ACTIVE+APPROVED should appear.
model MotivationalMessage {
  id        Int      @id @default(autoincrement())
  message   String   @db.Text
  category  String   @db.VarChar(40)
  language  String   @default("en") @db.VarChar(10)
  /// draft | approved
  status    String   @default("approved") @db.VarChar(20)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, status, language, category])
  @@map("motivational_messages")
}

/// Public site feedback submissions.
model Feedback {
  id        Int      @id @default(autoincrement())
  name      String?  @db.VarChar(120)
  email     String?  @db.VarChar(255)
  /// bug | idea | hifz | translation | other
  category  String   @default("other") @db.VarChar(40)
  message   String   @db.Text
  /// 1–5 optional
  rating    Int?
  userId    Int?     @map("user_id")
  pageUrl   String?  @map("page_url") @db.VarChar(500)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([category])
  @@map("feedback")
}
