# Server
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Database (docker-compose maps Postgres to host port 5435)
DATABASE_URL="postgresql://quran:quran_secret@localhost:5435/quran_app?schema=public"

# Quran Foundation Content API (backend only; never prefix these with NEXT_PUBLIC_)
QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_ENV=production
QF_AUTH_BASE_URL=https://oauth2.quran.foundation
QF_API_BASE_URL=https://apis.quran.foundation
# Import WBW + ayah translations + tafsir into Postgres (reader then serves from our API):
#   Local:  ./scripts/import-all-content.sh
#   Or:     ./scripts/import-all-translations.sh && cd backend && npm run tafsir:import
#   Prod:   sudo ./scripts/import-all-translations.sh --ayahs-only
#   Filter: cd backend && npm run translations:import -- --langs=en,ur,bn
#   WBW:    cd backend && npm run words:import -- --langs=en,ur,bn,id,tr,fa,hi
#   Tafsir: cd backend && npm run tafsir:import
#   Hadith/lessons/Q&A: cd backend && npm run study:import
# DATABASE_URL is injected by docker-compose on prod (postgres hostname); keep QF_* here.

# Local audio mirror (reciters, spoken translations, word-by-word). Download on the host:
#   node backend/scripts/download-all-audio.mjs
#   node scripts/fetch-translation-audio.mjs --reciter=all
#   node scripts/fetch-pashto-audio.mjs
AUDIO_STORAGE_PATH=storage/audio
AUDIO_PUBLIC_BASE_URL=http://localhost:4010/api/v1/audio/files

# Redis (use with docker-compose or your Redis)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600

# JWT / session cookies (HttpOnly qp_access + qp_refresh)
# Use a long random secret in production. Never expose to the frontend.
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Legacy alias still honored as access-token fallback if JWT_ACCESS_EXPIRES_IN unset
JWT_EXPIRES_IN=15m

# CORS (comma-separated origins; credentials required for cookie auth)
CORS_ORIGINS=http://localhost:3010,https://quranpilot.com,https://www.quranpilot.com
FRONTEND_URL=http://localhost:3010

# Optional: set to `.quranpilot.com` only if API and web use different subdomains
# COOKIE_DOMAIN=.quranpilot.com

# Optional SMTP (Gmail: use an App Password — https://myaccount.google.com/apppasswords)
# SMTP_URL=smtps://user:app-password@smtp.gmail.com:465
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM="QuranPilot <you@gmail.com>"
# New site feedback is emailed to SMTP_USER by default (or override):
# FEEDBACK_NOTIFY_EMAIL=you@gmail.com

# Stripe donations — primary payment gateway (https://dashboard.stripe.com/apikeys)
# Required for live/test checkout via Payment Element on /donate/checkout
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional webhooks: stripe listen --forward-to localhost:4010/api/v1/donations/webhook
STRIPE_WEBHOOK_SECRET=

# Google Gemini — QuranPilot Ask AI (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Free prompt cap per IP (0 = unlimited). Production compose defaults to 3.
AI_PROMPT_LIMIT=0

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
